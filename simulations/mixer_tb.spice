.subckt gilbert_mixer Vout_n Vout_p vlo vlo_b vrf vrf_b Ibias_n_50uA Ibias_p_50uA VSS VDD_3v3
*.ipin vlo
*.ipin vlo_b
*.ipin vrf
*.ipin vrf_b
*.opin Vout_p
*.opin Vout_n
*.iopin Ibias_n_50uA
*.iopin Ibias_p_50uA
*.iopin VSS
*.iopin VDD_3v3
