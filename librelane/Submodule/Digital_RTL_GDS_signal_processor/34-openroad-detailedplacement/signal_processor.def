    - votes_in_phase[2] ( PIN votes_in_phase[2] ) ( output15 Z ) + USE SIGNAL ;
    - votes_in_phase[3] ( PIN votes_in_phase[3] ) ( output16 Z ) + USE SIGNAL ;
    - votes_out_phase[0] ( PIN votes_out_phase[0] ) ( output17 Z ) + USE SIGNAL ;
    - votes_out_phase[1] ( PIN votes_out_phase[1] ) ( output18 Z ) + USE SIGNAL ;
    - votes_out_phase[2] ( PIN votes_out_phase[2] ) ( output19 Z ) + USE SIGNAL ;
    - votes_out_phase[3] ( PIN votes_out_phase[3] ) ( output20 Z ) + USE SIGNAL ;
END NETS
END DESIGN
